---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedPosts } from '../../../blog';
import { HTML_LANG, UI, localePath, localeStaticPaths } from '../../../i18n';

export async function getStaticPaths() {
  // 每篇文章生成英文和中文两个地址：/blog/<slug>/ 和 /zh/blog/<slug>/。
  // 某种语言还没有译文时，该地址显示另一种语言的版本。
  const pages = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) =>
      (await getLocalizedPosts(props.lang)).map((item) => ({
        params: { ...params, slug: item.slug },
        props: { ...props, ...item },
      }))
    )
  );
  return pages.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, slug, post, postLang } = Astro.props;
const t = UI[lang];
const { Content } = await render(post);
const formattedDate = post.data.date.toISOString().slice(0, 10);
const translatedFrom = post.data.translatedFrom;
---

<BaseLayout title={`${post.data.title} // 01iverx`} description={post.data.description} lang={lang}>
  <a class="back-link" href={localePath(lang, '/blog/')}>&lt;- BACK TO /BLOG</a>

  {postLang !== lang && <p class="post-note">{t.untranslated}</p>}
  {postLang === lang && translatedFrom && (
    <p class="post-note">
      {t.machineTranslated}
      <a href={localePath(translatedFrom, `/blog/${slug}/`)} hreflang={HTML_LANG[translatedFrom]}>{t.readOriginal} -&gt;</a>
    </p>
  )}

  <article lang={HTML_LANG[postLang]}>
    <header class="article-header">
      <div class="article-meta">
        <time datetime={formattedDate}>{formattedDate}</time>
        <div class="article-tags">
          {post.data.tags.map((tag) => <span class="tag-pill">#{tag}</span>)}
        </div>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-desc">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--pink);
    margin-bottom: 18px;
  }

  .post-note {
    margin-bottom: 18px;
    padding: 8px 12px;
    border-left: 3px solid var(--yellow);
    background: rgba(252, 238, 9, 0.08);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .post-note a {
    margin-left: 8px;
  }

  .article-header {
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-soft);
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .article-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 10px;
  }

  .article-desc {
    color: var(--muted);
    font-size: 0.94rem;
  }
</style>
